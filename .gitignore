# Personal HUD positions and sizes (saved locally by the game).
/game/data/ui_layout.json

# Local archives and files awaiting manual cleanup.
/to_delete/
/assets/sprites_archive/
/assets/models/

# Generated local diagnostics and sprite review outputs.
/look_tests/perf/
/look_tests/tank_sprite_preview/
/look_tests/kuroda_sprite_preview/
/debug.log

# Local npm install (sharp, playwright for sprite export).
/node_modules/

# Local save files (F1).
saves/

# Source art (generated images, concepts): kept on disk and in backups, not in git (Tim 2026-11-02)
/assets/environment/**/*.png
/assets/environment/**/*.jpg
/assets/environment/**/*.webp
/assets/concepts/

# Exceptions to the source-art rule above: the game loads these island textures
# at runtime, so they must be in git or a fresh copy of the repo is missing them.
